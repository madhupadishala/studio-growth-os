// ============================================================================
// AGENT GOVERNANCE
// ============================================================================

model AgentTrace {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  conversationId  String   @map("conversation_id")
  leadId          String   @map("lead_id")
  toolName        String   @map("tool_name")
  inputJson       Json     @map("input_json")
  outputJson      Json     @map("output_json")
  policyDecision  String   @map("policy_decision")
  latencyMs       Int      @map("latency_ms")
  createdAt       DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, conversationId])
  @@index([tenantId, leadId])
  @@map("agent_traces")
}

model ConnectorHealth {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  provider        String
  status          String
  lastSuccessAt   DateTime? @map("last_success_at")
  errorRate5m     Float    @map("error_rate_5m")
  errorRate24h    Float    @map("error_rate_24h")
  quotaRemaining  Int?     @map("quota_remaining")
  detailsJson     Json?    @map("details_json")
  checkedAt       DateTime @default(now()) @map("checked_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider])
  @@map("connector_health")
}

