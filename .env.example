# Studio Growth OS v2.0 - Environment Variables
# Copy this file to .env and fill in your values

# ============================================================================
# APP SETTINGS
# ============================================================================
APP_NAME=Studio Growth OS
VERSION=2.0.0
ENVIRONMENT=development
DEBUG=true

# ============================================================================
# DATABASE (PostgreSQL)
# ============================================================================
DATABASE_URL=postgresql://studio:studio_dev_password@localhost:5432/studio_growth_os

# ============================================================================
# REDIS (Queue, Cache, Sessions)
# ============================================================================
REDIS_URL=redis://localhost:6379

# ============================================================================
# AUTH & SECURITY
# ============================================================================
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
JWT_SECRET=your-jwt-secret-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ============================================================================
# META / WHATSAPP / INSTAGRAM
# Get from: https://developers.facebook.com/
# ============================================================================
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret

# WhatsApp Business API
# Get from: https://developers.facebook.com/docs/whatsapp/business-management-api
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token
WHATSAPP_WEBHOOK_URL=https://your-domain.com/api/v1/webhooks/whatsapp

# Instagram (uses same Meta app)
# Requires: Instagram Professional Account, pages_show_list, pages_read_engagement,
# instagram_basic, instagram_manage_comments, instagram_manage_insights

# ============================================================================
# YOUTUBE
# Get from: https://console.cloud.google.com/
# Enable: YouTube Data API v3
# ============================================================================
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_API_KEY=your_youtube_api_key
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/auth/callback/youtube

# ============================================================================
# GOOGLE BUSINESS PROFILE (My Business API)
# Get from: https://console.cloud.google.com/
# Enable: My Business API, Places API
# ============================================================================
GBP_CLIENT_ID=your_gbp_client_id
GBP_CLIENT_SECRET=your_gbp_client_secret
GBP_REDIRECT_URI=http://localhost:3000/api/auth/callback/gbp

# ============================================================================
# RAZORPAY PAYMENTS
# Get from: https://dashboard.razorpay.com/
# Test mode keys start with rzp_test_, live with rzp_live_
# ============================================================================
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=rzp_test_your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_from_razorpay_dashboard

# ============================================================================
# AI / LLM
# Choose one or both
# ============================================================================
OPENAI_API_KEY=sk-your-openai-api-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=500

# ============================================================================
# MEDIA STORAGE (Cloudflare R2 / AWS S3)
# ============================================================================
# Cloudflare R2 (recommended - no egress fees)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=studio-growth-os-media
R2_PUBLIC_URL=https://pub-xxxxx.r2.dev

# Or AWS S3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_S3_REGION=

# ============================================================================
# EMAIL (Optional - for notifications, reports)
# ============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=Studiox Photography <noreply@rungrow.in>

# ============================================================================
# DEMO STUDIO SETTINGS (Pre-filled for Studiox)
# ============================================================================
DEMO_STUDIO_ID=studiox
DEMO_STUDIO_SLUG=studiox
DEMO_STUDIO_DOMAIN=rungrow.in
DEMO_STUDIO_PHONE=+917285988958
DEMO_STUDIO_EMAIL=support@rungrow.in
DEMO_STUDIO_INSTAGRAM=studioxphotograpghy
DEMO_STUDIO_YOUTUBE=@mandatisreenath